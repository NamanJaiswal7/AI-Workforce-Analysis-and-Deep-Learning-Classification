<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_Preprocessing"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.0.0">

  <bpmn:process id="Process_Preprocessing" name="Data Preprocessing Subprocess" isExecutable="false">

    <bpmn:startEvent id="StartEvent_P" name="Raw Data&#10;Received">
      <bpmn:outgoing>Flow_P01</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_ParseData" name="Parse Raw Data&#10;(JSON → DataFrame for LT,&#10;XML → DataFrame for ISCO)">
      <bpmn:incoming>Flow_P01</bpmn:incoming>
      <bpmn:outgoing>Flow_P02</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_CleanText" name="Clean Text&#10;(Remove HTML tags,&#10;URLs, special characters)">
      <bpmn:incoming>Flow_P02</bpmn:incoming>
      <bpmn:outgoing>Flow_P03</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_NormalizeUnicode" name="Normalize Unicode (NFC)&#10;&amp; Preserve Lithuanian&#10;Diacritics (ą,č,ę,ė,į,š,ų,ū,ž)">
      <bpmn:incoming>Flow_P03</bpmn:incoming>
      <bpmn:outgoing>Flow_P04</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_Lowercase" name="Lowercase Text&#10;&amp; Normalize&#10;Whitespace">
      <bpmn:incoming>Flow_P04</bpmn:incoming>
      <bpmn:outgoing>Flow_P05</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_VerifyTokenization" name="Verify SentencePiece&#10;Tokenization&#10;(Subword Decomposition)">
      <bpmn:incoming>Flow_P05</bpmn:incoming>
      <bpmn:outgoing>Flow_P06</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_TokenCheck" name="Subwords capture&#10;shared roots?">
      <bpmn:incoming>Flow_P06</bpmn:incoming>
      <bpmn:outgoing>Flow_P07</bpmn:outgoing>
      <bpmn:outgoing>Flow_P07b</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_LoadGlossary" name="Load Bilingual Glossary&#10;(~200 domain-specific&#10;LT → EN term pairs)">
      <bpmn:incoming>Flow_P07</bpmn:incoming>
      <bpmn:outgoing>Flow_P08</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_AdjustTokenizer" name="Add Domain Terms&#10;to Glossary &amp;&#10;Re-verify">
      <bpmn:incoming>Flow_P07b</bpmn:incoming>
      <bpmn:outgoing>Flow_P07c</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_KeywordMatch" name="Keyword-based Initial&#10;Label Matching&#10;(TF-IDF + Glossary)">
      <bpmn:incoming>Flow_P08</bpmn:incoming>
      <bpmn:outgoing>Flow_P09</bpmn:outgoing>
    </bpmn:task>

    <bpmn:userTask id="UserTask_ManualVerify" name="Manual Label&#10;Verification&#10;(Author + Supervisor)">
      <bpmn:incoming>Flow_P09</bpmn:incoming>
      <bpmn:outgoing>Flow_P10</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:task id="Task_ClassWeighting" name="Compute Class Weights&#10;(Inverse Frequency)&#10;&amp; Apply Stratified Split">
      <bpmn:incoming>Flow_P10</bpmn:incoming>
      <bpmn:outgoing>Flow_P11</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_OutputDataset" name="Output Normalized&#10;Dataset&#10;(Train / Val / Test)">
      <bpmn:incoming>Flow_P11</bpmn:incoming>
      <bpmn:outgoing>Flow_P12</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_P" name="Preprocessed&#10;Dataset Ready">
      <bpmn:incoming>Flow_P12</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Text Annotations -->

    <bpmn:textAnnotation id="TextAnnotation_Morphology">
      <bpmn:text>Lithuanian morphology handled by
SentencePiece subword tokenization:
programų → program + ų
(Intermediate Fusion via XLM-RoBERTa)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Morph" sourceRef="TextAnnotation_Morphology" targetRef="Task_VerifyTokenization" />

    <bpmn:textAnnotation id="TextAnnotation_Glossary">
      <bpmn:text>Examples:
programavimas → programming
dirbtinis intelektas → artificial intelligence
duomenų bazės → databases</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Gloss" sourceRef="TextAnnotation_Glossary" targetRef="Task_LoadGlossary" />

    <bpmn:textAnnotation id="TextAnnotation_SemiAuto">
      <bpmn:text>Semi-automatic label assignment:
1. TF-IDF candidate matching
2. Human verification &amp; correction
3. Confidence level recording</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_SemiAuto" sourceRef="TextAnnotation_SemiAuto" targetRef="UserTask_ManualVerify" />

    <!-- Sequence Flows -->

    <bpmn:sequenceFlow id="Flow_P01" sourceRef="StartEvent_P" targetRef="Task_ParseData" />
    <bpmn:sequenceFlow id="Flow_P02" sourceRef="Task_ParseData" targetRef="Task_CleanText" />
    <bpmn:sequenceFlow id="Flow_P03" sourceRef="Task_CleanText" targetRef="Task_NormalizeUnicode" />
    <bpmn:sequenceFlow id="Flow_P04" sourceRef="Task_NormalizeUnicode" targetRef="Task_Lowercase" />
    <bpmn:sequenceFlow id="Flow_P05" sourceRef="Task_Lowercase" targetRef="Task_VerifyTokenization" />
    <bpmn:sequenceFlow id="Flow_P06" sourceRef="Task_VerifyTokenization" targetRef="Gateway_TokenCheck" />
    <bpmn:sequenceFlow id="Flow_P07" name="Yes" sourceRef="Gateway_TokenCheck" targetRef="Task_LoadGlossary" />
    <bpmn:sequenceFlow id="Flow_P07b" name="No" sourceRef="Gateway_TokenCheck" targetRef="Task_AdjustTokenizer" />
    <bpmn:sequenceFlow id="Flow_P07c" sourceRef="Task_AdjustTokenizer" targetRef="Task_VerifyTokenization" />
    <bpmn:sequenceFlow id="Flow_P08" sourceRef="Task_LoadGlossary" targetRef="Task_KeywordMatch" />
    <bpmn:sequenceFlow id="Flow_P09" sourceRef="Task_KeywordMatch" targetRef="UserTask_ManualVerify" />
    <bpmn:sequenceFlow id="Flow_P10" sourceRef="UserTask_ManualVerify" targetRef="Task_ClassWeighting" />
    <bpmn:sequenceFlow id="Flow_P11" sourceRef="Task_ClassWeighting" targetRef="Task_OutputDataset" />
    <bpmn:sequenceFlow id="Flow_P12" sourceRef="Task_OutputDataset" targetRef="EndEvent_P" />

  </bpmn:process>

  <!-- ==================== DIAGRAM ==================== -->

  <bpmndi:BPMNDiagram id="BPMNDiagram_P">
    <bpmndi:BPMNPlane id="BPMNPlane_P" bpmnElement="Process_Preprocessing">

      <!-- Row 1 (y ≈ 200): Parsing and Cleaning -->
      <bpmndi:BPMNShape id="StartEvent_P_di" bpmnElement="StartEvent_P">
        <dc:Bounds x="162" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="150" y="225" width="60" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ParseData_di" bpmnElement="Task_ParseData">
        <dc:Bounds x="260" y="160" width="180" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_CleanText_di" bpmnElement="Task_CleanText">
        <dc:Bounds x="500" y="160" width="180" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_NormalizeUnicode_di" bpmnElement="Task_NormalizeUnicode">
        <dc:Bounds x="740" y="160" width="190" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_Lowercase_di" bpmnElement="Task_Lowercase">
        <dc:Bounds x="990" y="160" width="170" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_VerifyTokenization_di" bpmnElement="Task_VerifyTokenization">
        <dc:Bounds x="1220" y="160" width="190" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_TokenCheck_di" bpmnElement="Gateway_TokenCheck" isMarkerVisible="true">
        <dc:Bounds x="1470" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1452" y="232" width="86" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Branch for "No" - Adjust (above main row) -->
      <bpmndi:BPMNShape id="Task_AdjustTokenizer_di" bpmnElement="Task_AdjustTokenizer">
        <dc:Bounds x="1330" y="50" width="170" height="80" />
      </bpmndi:BPMNShape>

      <!-- Row 2 (y ≈ 420): Labeling and Output -->
      <bpmndi:BPMNShape id="Task_LoadGlossary_di" bpmnElement="Task_LoadGlossary">
        <dc:Bounds x="260" y="380" width="190" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_KeywordMatch_di" bpmnElement="Task_KeywordMatch">
        <dc:Bounds x="510" y="380" width="190" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="UserTask_ManualVerify_di" bpmnElement="UserTask_ManualVerify">
        <dc:Bounds x="760" y="380" width="180" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ClassWeighting_di" bpmnElement="Task_ClassWeighting">
        <dc:Bounds x="1000" y="380" width="190" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_OutputDataset_di" bpmnElement="Task_OutputDataset">
        <dc:Bounds x="1250" y="380" width="170" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_P_di" bpmnElement="EndEvent_P">
        <dc:Bounds x="1482" y="402" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1463" y="445" width="74" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Text Annotations -->
      <bpmndi:BPMNShape id="TextAnnotation_Morphology_di" bpmnElement="TextAnnotation_Morphology">
        <dc:Bounds x="1200" y="270" width="260" height="70" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="TextAnnotation_Glossary_di" bpmnElement="TextAnnotation_Glossary">
        <dc:Bounds x="220" y="490" width="260" height="70" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="TextAnnotation_SemiAuto_di" bpmnElement="TextAnnotation_SemiAuto">
        <dc:Bounds x="750" y="490" width="220" height="70" />
      </bpmndi:BPMNShape>

      <!-- Associations -->
      <bpmndi:BPMNEdge id="Association_Morph_di" bpmnElement="Association_Morph">
        <di:waypoint x="1315" y="270" />
        <di:waypoint x="1315" y="240" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Association_Gloss_di" bpmnElement="Association_Gloss">
        <di:waypoint x="355" y="490" />
        <di:waypoint x="355" y="460" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Association_SemiAuto_di" bpmnElement="Association_SemiAuto">
        <di:waypoint x="850" y="490" />
        <di:waypoint x="850" y="460" />
      </bpmndi:BPMNEdge>

      <!-- ==================== SEQUENCE FLOW EDGES ==================== -->

      <bpmndi:BPMNEdge id="Flow_P01_di" bpmnElement="Flow_P01">
        <di:waypoint x="198" y="200" />
        <di:waypoint x="260" y="200" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_P02_di" bpmnElement="Flow_P02">
        <di:waypoint x="440" y="200" />
        <di:waypoint x="500" y="200" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_P03_di" bpmnElement="Flow_P03">
        <di:waypoint x="680" y="200" />
        <di:waypoint x="740" y="200" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_P04_di" bpmnElement="Flow_P04">
        <di:waypoint x="930" y="200" />
        <di:waypoint x="990" y="200" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_P05_di" bpmnElement="Flow_P05">
        <di:waypoint x="1160" y="200" />
        <di:waypoint x="1220" y="200" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_P06_di" bpmnElement="Flow_P06">
        <di:waypoint x="1410" y="200" />
        <di:waypoint x="1470" y="200" />
      </bpmndi:BPMNEdge>

      <!-- Gateway → Load Glossary (Yes - down to row 2) -->
      <bpmndi:BPMNEdge id="Flow_P07_di" bpmnElement="Flow_P07">
        <di:waypoint x="1495" y="225" />
        <di:waypoint x="1495" y="320" />
        <di:waypoint x="355" y="320" />
        <di:waypoint x="355" y="380" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="920" y="302" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <!-- Gateway → Adjust Tokenizer (No - up) -->
      <bpmndi:BPMNEdge id="Flow_P07b_di" bpmnElement="Flow_P07b">
        <di:waypoint x="1495" y="175" />
        <di:waypoint x="1495" y="90" />
        <di:waypoint x="1500" y="90" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1501" y="130" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <!-- Adjust Tokenizer → loop back to Verify Tokenization -->
      <bpmndi:BPMNEdge id="Flow_P07c_di" bpmnElement="Flow_P07c">
        <di:waypoint x="1330" y="90" />
        <di:waypoint x="1315" y="90" />
        <di:waypoint x="1315" y="160" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_P08_di" bpmnElement="Flow_P08">
        <di:waypoint x="450" y="420" />
        <di:waypoint x="510" y="420" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_P09_di" bpmnElement="Flow_P09">
        <di:waypoint x="700" y="420" />
        <di:waypoint x="760" y="420" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_P10_di" bpmnElement="Flow_P10">
        <di:waypoint x="940" y="420" />
        <di:waypoint x="1000" y="420" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_P11_di" bpmnElement="Flow_P11">
        <di:waypoint x="1190" y="420" />
        <di:waypoint x="1250" y="420" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_P12_di" bpmnElement="Flow_P12">
        <di:waypoint x="1420" y="420" />
        <di:waypoint x="1482" y="420" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
