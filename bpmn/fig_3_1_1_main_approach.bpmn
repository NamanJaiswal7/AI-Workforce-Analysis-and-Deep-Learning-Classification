<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_MainApproach"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.0.0">

  <bpmn:process id="Process_MainApproach" name="Cross-Lingual Workforce Classification Approach" isExecutable="false">

    <!-- ==================== PHASE 1: DATA PREPARATION ==================== -->

    <bpmn:startEvent id="StartEvent_1" name="Start">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_IdentifySources" name="Identify Data Sources&#10;(LT Open Data Portal + ILO ISCO-08)">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:task>

    <bpmn:parallelGateway id="Gateway_ParallelFork" name="Fetch in Parallel">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:task id="Task_FetchStudyPrograms" name="Fetch Study Program&#10;Descriptions from&#10;Lithuanian Open Data Portal">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_FetchISCO" name="Fetch ISCO-08&#10;Classification Data&#10;from ILO (English)">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:task>

    <bpmn:parallelGateway id="Gateway_ParallelJoin" name="Synchronize">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:subProcess id="SubProcess_Preprocessing" name="Data Preprocessing&#10;(see Fig. 3.1.2)">
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:subProcess>

    <bpmn:task id="Task_ConstructLabels" name="Construct Labeled Dataset&#10;(Semi-automatic Annotation&#10;with Bilingual Glossary)">
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_SplitDataset" name="Split Dataset&#10;(Train 70% / Val 15%&#10;/ Test 15%)">
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>

    <!-- ==================== PHASE 2: CLASSIFICATION & REVIEW ==================== -->

    <bpmn:task id="Task_TrainModel" name="Fine-tune XLM-RoBERTa&#10;on Labeled Dataset&#10;(BCEWithLogitsLoss)">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_Validation" name="Validation&#10;passed?">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_Deploy" name="Deploy Model to&#10;Inference Pipeline">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:task>

    <bpmn:userTask id="UserTask_Input" name="Analyst Inputs Study&#10;Program Description&#10;via Streamlit Dashboard">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:task id="Task_Encode" name="Encode Input &amp;&#10;Compute Similarity Scores&#10;Against All ISCO Codes">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_RankPredictions" name="Return Top-k Ranked&#10;ISCO-08 Predictions&#10;with Confidence Scores">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:task>

    <bpmn:subProcess id="SubProcess_HumanReview" name="Human Review &amp;&#10;Validation&#10;(see Fig. 3.1.3)">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:subProcess>

    <bpmn:exclusiveGateway id="Gateway_MoreData" name="More programs&#10;to process?">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_CompileReport" name="Compile Final Report&#10;&amp; Log Feedback&#10;for Retraining">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_1" name="End">
      <bpmn:incoming>Flow_21</bpmn:incoming>
    </bpmn:endEvent>

    <!-- ==================== TEXT ANNOTATIONS ==================== -->

    <bpmn:textAnnotation id="TextAnnotation_Phase1">
      <bpmn:text>PHASE 1: DATA PREPARATION</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Phase1" sourceRef="TextAnnotation_Phase1" targetRef="Task_IdentifySources" />

    <bpmn:textAnnotation id="TextAnnotation_Phase2">
      <bpmn:text>PHASE 2: CLASSIFICATION &amp; REVIEW</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Phase2" sourceRef="TextAnnotation_Phase2" targetRef="Task_TrainModel" />

    <bpmn:textAnnotation id="TextAnnotation_Lithuanian">
      <bpmn:text>Data in Lithuanian language
(morphologically rich, ~1,487 programs)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_LT" sourceRef="TextAnnotation_Lithuanian" targetRef="Task_FetchStudyPrograms" />

    <bpmn:textAnnotation id="TextAnnotation_English">
      <bpmn:text>Data in English language
(43 sub-major groups at 2-digit level)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_EN" sourceRef="TextAnnotation_English" targetRef="Task_FetchISCO" />

    <!-- ==================== SEQUENCE FLOWS ==================== -->

    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_1" targetRef="Task_IdentifySources" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_IdentifySources" targetRef="Gateway_ParallelFork" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Gateway_ParallelFork" targetRef="Task_FetchStudyPrograms" />
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Gateway_ParallelFork" targetRef="Task_FetchISCO" />
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_FetchStudyPrograms" targetRef="Gateway_ParallelJoin" />
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_FetchISCO" targetRef="Gateway_ParallelJoin" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Gateway_ParallelJoin" targetRef="SubProcess_Preprocessing" />
    <bpmn:sequenceFlow id="Flow_08" sourceRef="SubProcess_Preprocessing" targetRef="Task_ConstructLabels" />
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_ConstructLabels" targetRef="Task_SplitDataset" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_SplitDataset" targetRef="Task_TrainModel" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_TrainModel" targetRef="Gateway_Validation" />
    <bpmn:sequenceFlow id="Flow_12" name="Yes" sourceRef="Gateway_Validation" targetRef="Task_Deploy" />
    <bpmn:sequenceFlow id="Flow_13" name="No (adjust&#10;hyperparameters)" sourceRef="Gateway_Validation" targetRef="Task_TrainModel" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_Deploy" targetRef="UserTask_Input" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="UserTask_Input" targetRef="Task_Encode" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_Encode" targetRef="Task_RankPredictions" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_RankPredictions" targetRef="SubProcess_HumanReview" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="SubProcess_HumanReview" targetRef="Gateway_MoreData" />
    <bpmn:sequenceFlow id="Flow_19" name="Yes" sourceRef="Gateway_MoreData" targetRef="UserTask_Input" />
    <bpmn:sequenceFlow id="Flow_20" name="No" sourceRef="Gateway_MoreData" targetRef="Task_CompileReport" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_CompileReport" targetRef="EndEvent_1" />

  </bpmn:process>

  <!-- ==================== DIAGRAM ==================== -->

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_MainApproach">

      <!-- Phase 1 elements -->
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="162" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="168" y="225" width="24" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_IdentifySources_di" bpmnElement="Task_IdentifySources">
        <dc:Bounds x="250" y="160" width="170" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_ParallelFork_di" bpmnElement="Gateway_ParallelFork">
        <dc:Bounds x="470" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="530" y="190" width="78" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_FetchStudyPrograms_di" bpmnElement="Task_FetchStudyPrograms">
        <dc:Bounds x="570" y="80" width="190" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_FetchISCO_di" bpmnElement="Task_FetchISCO">
        <dc:Bounds x="570" y="250" width="190" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_ParallelJoin_di" bpmnElement="Gateway_ParallelJoin">
        <dc:Bounds x="815" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="SubProcess_Preprocessing_di" bpmnElement="SubProcess_Preprocessing" isExpanded="false">
        <dc:Bounds x="920" y="155" width="190" height="90" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ConstructLabels_di" bpmnElement="Task_ConstructLabels">
        <dc:Bounds x="1160" y="160" width="180" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_SplitDataset_di" bpmnElement="Task_SplitDataset">
        <dc:Bounds x="1400" y="160" width="170" height="80" />
      </bpmndi:BPMNShape>

      <!-- Phase 2 elements -->
      <bpmndi:BPMNShape id="Task_TrainModel_di" bpmnElement="Task_TrainModel">
        <dc:Bounds x="160" y="420" width="190" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_Validation_di" bpmnElement="Gateway_Validation" isMarkerVisible="true">
        <dc:Bounds x="405" y="435" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="398" y="492" width="64" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_Deploy_di" bpmnElement="Task_Deploy">
        <dc:Bounds x="510" y="420" width="170" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="UserTask_Input_di" bpmnElement="UserTask_Input">
        <dc:Bounds x="740" y="420" width="190" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_Encode_di" bpmnElement="Task_Encode">
        <dc:Bounds x="990" y="420" width="190" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_RankPredictions_di" bpmnElement="Task_RankPredictions">
        <dc:Bounds x="1240" y="420" width="190" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="SubProcess_HumanReview_di" bpmnElement="SubProcess_HumanReview" isExpanded="false">
        <dc:Bounds x="1490" y="415" width="190" height="90" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_MoreData_di" bpmnElement="Gateway_MoreData" isMarkerVisible="true">
        <dc:Bounds x="1740" y="435" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1727" y="492" width="76" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_CompileReport_di" bpmnElement="Task_CompileReport">
        <dc:Bounds x="1850" y="420" width="170" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="2082" y="442" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2090" y="485" width="20" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Text Annotations -->
      <bpmndi:BPMNShape id="TextAnnotation_Phase1_di" bpmnElement="TextAnnotation_Phase1">
        <dc:Bounds x="160" y="60" width="250" height="30" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="TextAnnotation_Phase2_di" bpmnElement="TextAnnotation_Phase2">
        <dc:Bounds x="160" y="370" width="290" height="30" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="TextAnnotation_Lithuanian_di" bpmnElement="TextAnnotation_Lithuanian">
        <dc:Bounds x="610" y="20" width="200" height="45" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="TextAnnotation_English_di" bpmnElement="TextAnnotation_English">
        <dc:Bounds x="610" y="345" width="220" height="45" />
      </bpmndi:BPMNShape>

      <!-- Associations -->
      <bpmndi:BPMNEdge id="Association_Phase1_di" bpmnElement="Association_Phase1">
        <di:waypoint x="285" y="90" />
        <di:waypoint x="310" y="160" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Association_Phase2_di" bpmnElement="Association_Phase2">
        <di:waypoint x="285" y="400" />
        <di:waypoint x="270" y="420" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Association_LT_di" bpmnElement="Association_LT">
        <di:waypoint x="680" y="65" />
        <di:waypoint x="665" y="80" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Association_EN_di" bpmnElement="Association_EN">
        <di:waypoint x="690" y="345" />
        <di:waypoint x="665" y="330" />
      </bpmndi:BPMNEdge>

      <!-- ==================== SEQUENCE FLOW EDGES ==================== -->

      <!-- Flow_01: Start → Identify Sources -->
      <bpmndi:BPMNEdge id="Flow_01_di" bpmnElement="Flow_01">
        <di:waypoint x="198" y="200" />
        <di:waypoint x="250" y="200" />
      </bpmndi:BPMNEdge>

      <!-- Flow_02: Identify Sources → Parallel Fork -->
      <bpmndi:BPMNEdge id="Flow_02_di" bpmnElement="Flow_02">
        <di:waypoint x="420" y="200" />
        <di:waypoint x="470" y="200" />
      </bpmndi:BPMNEdge>

      <!-- Flow_03: Fork → Fetch Study Programs (up) -->
      <bpmndi:BPMNEdge id="Flow_03_di" bpmnElement="Flow_03">
        <di:waypoint x="495" y="175" />
        <di:waypoint x="495" y="120" />
        <di:waypoint x="570" y="120" />
      </bpmndi:BPMNEdge>

      <!-- Flow_04: Fork → Fetch ISCO (down) -->
      <bpmndi:BPMNEdge id="Flow_04_di" bpmnElement="Flow_04">
        <di:waypoint x="495" y="225" />
        <di:waypoint x="495" y="290" />
        <di:waypoint x="570" y="290" />
      </bpmndi:BPMNEdge>

      <!-- Flow_05: Fetch Study Programs → Join (up path) -->
      <bpmndi:BPMNEdge id="Flow_05_di" bpmnElement="Flow_05">
        <di:waypoint x="760" y="120" />
        <di:waypoint x="840" y="120" />
        <di:waypoint x="840" y="175" />
      </bpmndi:BPMNEdge>

      <!-- Flow_06: Fetch ISCO → Join (down path) -->
      <bpmndi:BPMNEdge id="Flow_06_di" bpmnElement="Flow_06">
        <di:waypoint x="760" y="290" />
        <di:waypoint x="840" y="290" />
        <di:waypoint x="840" y="225" />
      </bpmndi:BPMNEdge>

      <!-- Flow_07: Join → Preprocessing -->
      <bpmndi:BPMNEdge id="Flow_07_di" bpmnElement="Flow_07">
        <di:waypoint x="865" y="200" />
        <di:waypoint x="920" y="200" />
      </bpmndi:BPMNEdge>

      <!-- Flow_08: Preprocessing → Construct Labels -->
      <bpmndi:BPMNEdge id="Flow_08_di" bpmnElement="Flow_08">
        <di:waypoint x="1110" y="200" />
        <di:waypoint x="1160" y="200" />
      </bpmndi:BPMNEdge>

      <!-- Flow_09: Construct Labels → Split Dataset -->
      <bpmndi:BPMNEdge id="Flow_09_di" bpmnElement="Flow_09">
        <di:waypoint x="1340" y="200" />
        <di:waypoint x="1400" y="200" />
      </bpmndi:BPMNEdge>

      <!-- Flow_10: Split Dataset → Train Model (down from row 1 to row 2) -->
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10">
        <di:waypoint x="1485" y="240" />
        <di:waypoint x="1485" y="340" />
        <di:waypoint x="255" y="340" />
        <di:waypoint x="255" y="420" />
      </bpmndi:BPMNEdge>

      <!-- Flow_11: Train Model → Validation Gateway -->
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11">
        <di:waypoint x="350" y="460" />
        <di:waypoint x="405" y="460" />
      </bpmndi:BPMNEdge>

      <!-- Flow_12: Validation → Deploy (Yes) -->
      <bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12">
        <di:waypoint x="455" y="460" />
        <di:waypoint x="510" y="460" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="475" y="442" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <!-- Flow_13: Validation → Train Model (No, loop back) -->
      <bpmndi:BPMNEdge id="Flow_13_di" bpmnElement="Flow_13">
        <di:waypoint x="430" y="485" />
        <di:waypoint x="430" y="540" />
        <di:waypoint x="255" y="540" />
        <di:waypoint x="255" y="500" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="305" y="546" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <!-- Flow_14: Deploy → User Input -->
      <bpmndi:BPMNEdge id="Flow_14_di" bpmnElement="Flow_14">
        <di:waypoint x="680" y="460" />
        <di:waypoint x="740" y="460" />
      </bpmndi:BPMNEdge>

      <!-- Flow_15: User Input → Encode -->
      <bpmndi:BPMNEdge id="Flow_15_di" bpmnElement="Flow_15">
        <di:waypoint x="930" y="460" />
        <di:waypoint x="990" y="460" />
      </bpmndi:BPMNEdge>

      <!-- Flow_16: Encode → Rank Predictions -->
      <bpmndi:BPMNEdge id="Flow_16_di" bpmnElement="Flow_16">
        <di:waypoint x="1180" y="460" />
        <di:waypoint x="1240" y="460" />
      </bpmndi:BPMNEdge>

      <!-- Flow_17: Rank Predictions → Human Review -->
      <bpmndi:BPMNEdge id="Flow_17_di" bpmnElement="Flow_17">
        <di:waypoint x="1430" y="460" />
        <di:waypoint x="1490" y="460" />
      </bpmndi:BPMNEdge>

      <!-- Flow_18: Human Review → More Data Gateway -->
      <bpmndi:BPMNEdge id="Flow_18_di" bpmnElement="Flow_18">
        <di:waypoint x="1680" y="460" />
        <di:waypoint x="1740" y="460" />
      </bpmndi:BPMNEdge>

      <!-- Flow_19: More Data → User Input (Yes, loop back) -->
      <bpmndi:BPMNEdge id="Flow_19_di" bpmnElement="Flow_19">
        <di:waypoint x="1765" y="485" />
        <di:waypoint x="1765" y="570" />
        <di:waypoint x="835" y="570" />
        <di:waypoint x="835" y="500" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1290" y="552" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <!-- Flow_20: More Data → Compile Report (No) -->
      <bpmndi:BPMNEdge id="Flow_20_di" bpmnElement="Flow_20">
        <di:waypoint x="1790" y="460" />
        <di:waypoint x="1850" y="460" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1813" y="442" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <!-- Flow_21: Compile Report → End -->
      <bpmndi:BPMNEdge id="Flow_21_di" bpmnElement="Flow_21">
        <di:waypoint x="2020" y="460" />
        <di:waypoint x="2082" y="460" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
